{
  "name": "magpie-image-webp",
  "version": "0.1.0",
  "description": "Magpie gateway hook: re-encode inline images as WebP and downsample them before they leave your gateway",
  "type": "module",
  "files": [
    "image-webp.hooks.mjs",
    "lib/*.mjs",
    "page",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-gateway",
    "magpie-hooks",
    "webp",
    "image-compression"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnzgray/magpie-image-webp.git"
  },
  "homepage": "https://github.com/cnzgray/magpie-image-webp",
  "magpie": {
    "name": "Image WebP",
    "summary": {
      "en": "Re-encode inline images as WebP and cap their width before requests leave the gateway: fewer bytes on slow uplinks and an earlier first token, with no client changes.",
      "zh": "在网关内把内联图片转成 WebP 并按宽度降采样：慢上行更省字节、首 token 更早，客户端无需改动。"
    },
    "icon": "data:image/svg+xml;base64,",
    "hooks": "./image-webp.hooks.mjs",
    "page": {
      "title": "Image WebP",
      "titles": {
        "zh": "图片压缩"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [],
    "options": {
      "agents": [
        "dsh",
        "codex"
      ],
      "width": 1600,
      "quality": 85,
      "max": 4,
      "min": 131072,
      "cacheMB": 64,
      "gatewayTimeoutMs": 5000
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "test": "bun test"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0"
  }
}
